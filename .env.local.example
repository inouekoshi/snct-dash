# Supabase（ローカル開発では開発DB kosendash-dev を指定する）
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 任意：メンテナンス中にする学科ID（カンマ区切り。例: 4）。その学科は選べず、プレイ開始も受け付けない
# NEXT_PUBLIC_MAINTENANCE_DEPARTMENTS=

# 任意：Vercel Cron（/api/cron/warmup）の認証用。設定すると Authorization ヘッダーを検証する
# CRON_SECRET=
